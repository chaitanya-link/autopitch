# Frontend environment variables — copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit real secrets.

# URL where the backend API is reachable.
VITE_API_URL=http://127.0.0.1:8000

# Supabase project — the anon/publishable key is safe to expose client-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
