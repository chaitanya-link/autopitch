# Backend environment variables — copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit real secrets.

# Supabase project (Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase Postgres connection string — use the "Transaction pooler" URI
# (Settings -> Database -> Connect), not the direct connection, which may only
# resolve over IPv6 on some networks. URL-encode any special characters in the
# password (e.g. @ -> %40).
DATABASE_URL=

# Google AI Studio API key (aistudio.google.com/apikey) — powers RAG embeddings
# and the drafting agent (Gemini).
GEMINI_API_KEY=

# Dedicated Gmail account for sending outreach — NOT your personal inbox.
# GMAIL_APP_PASSWORD requires 2-Step Verification enabled on that account;
# generate one at myaccount.google.com/apppasswords.
GMAIL_SENDER_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: Supabase service_role key, used only for one-off server-side admin
# operations (e.g. manually confirming a test account). Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated list of allowed CORS origins for the deployed frontend.
# Defaults to http://localhost:5173,http://127.0.0.1:5173 if unset.
FRONTEND_URL=
